{
  "name": "opencode-penpot-selection",
  "version": "0.1.0",
  "description": "Attach explicitly selected Penpot layers to an OpenCode session.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": ["src", "scripts", "index.ts", "tui.tsx", "rpc.ts", "README.md", "LICENSE", "SECURITY.md", "AGENTS.md", "docs", "examples"],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "install:global": "node scripts/install-global.mjs",
    "uninstall:global": "node scripts/install-global.mjs uninstall",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {"node": ">=22.18"},
  "peerDependencies": {
    "@opencode/plugin": "^2.1.3",
    "@opentui/core": ">=0.6.6 <0.7",
    "@opentui/solid": ">=0.6.6 <0.7",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
